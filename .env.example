# ==============================================================================
# Multimodal Construction Intelligence Platform - Environment Variables
# ==============================================================================

# Google Gemini API Key (Multimodal Vision & Language Processing)
# Get your free key at: https://aistudio.google.com/
# If left blank, the application operates in transparent Demo / Simulated mode.
GEMINI_API_KEY=

# MongoDB Atlas URI (Persistent History, Projects, and Analysis Reports)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/construction_db?retryWrites=true&w=majority
# If left blank, the application operates in In-Memory Session storage with clear UI notifications.
MONGODB_URI=
MONGODB_DB_NAME=construction_intelligence

# Optional Weather API Key (OpenWeatherMap or WeatherAPI)
# Note: The platform by default queries Open-Meteo API (requires NO key and provides 100% real live data globally).
# Providing WEATHER_API_KEY enables enhanced enterprise weather feeds where supported.
WEATHER_API_KEY=

# Application Host & Port (Local Development)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://*.vercel.app"]

# Frontend API base URL (defaults to relative "/api" in production)
VITE_API_BASE_URL=
